NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=portal_backend
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=./private-uploads
MAX_FILE_SIZE_MB=10

# Use different, long random values. Never commit your real .env.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
